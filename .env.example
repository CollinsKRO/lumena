# =============================================================================
# Lumen server — environment configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit a real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Stellar network
# -----------------------------------------------------------------------------
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# -----------------------------------------------------------------------------
# Signer provider
# -----------------------------------------------------------------------------
# Controls how the co-signer and fee-payer private keys are accessed.
#
#   env     (default) — raw Stellar secret keys loaded from the variables below.
#                       Safe for local development and testnet only.
#                       ⚠  These keys are CUSTODIAL: they can approve user txs
#                       and spend XLM.  Do NOT use raw secrets in production.
#
#   awskms  (recommended for production) — private keys never leave AWS KMS /
#           CloudHSM.  Set the KMS_* variables below and leave COSIGNER_SECRET
#           and FEE_PAYER_SECRET unset.
#           Requires @aws-sdk/client-kms and appropriate IAM permissions.
#           See docs/production-key-management.md.
#
#   pkcs11  (enterprise custody) — private keys never leave an on-premises or
#           cloud HSM accessed via the PKCS#11 C API.  Set the PKCS11_*
#           variables below and leave COSIGNER_SECRET and FEE_PAYER_SECRET
#           unset.  Requires the pkcs11js native binding and the vendor's
#           PKCS#11 module (e.g. SoftHSM2 for local integration testing).
#
SIGNER_PROVIDER=env

# -----------------------------------------------------------------------------
# Dev / testnet secrets (SIGNER_PROVIDER=env only)
# ⚠  Raw secret keys in environment variables are NOT suitable for production.
#    A stolen COSIGNER_SECRET lets an attacker co-sign arbitrary user txs.
#    A stolen FEE_PAYER_SECRET drains your XLM fee reserve.
#    Use SIGNER_PROVIDER=awskms in production instead.
# -----------------------------------------------------------------------------
COSIGNER_SECRET=S...          # Server co-signer secret key  (testnet only)
FEE_PAYER_SECRET=S...         # Fee sponsor secret key        (testnet only)

# -----------------------------------------------------------------------------
# AWS KMS signers (SIGNER_PROVIDER=awskms only)
# These are IGNORED when SIGNER_PROVIDER=env.
# -----------------------------------------------------------------------------
# KMS_COSIGNER_KEY_ID=arn:aws:kms:<region>:<account>:key/<uuid>
# KMS_FEE_PAYER_KEY_ID=arn:aws:kms:<region>:<account>:key/<uuid>
# KMS_REGION=us-east-1

# -----------------------------------------------------------------------------
# PKCS#11 HSM signer (SIGNER_PROVIDER=pkcs11 only)
# These are IGNORED unless SIGNER_PROVIDER=pkcs11.
# Private key material never leaves the HSM; only signatures are returned.
# -----------------------------------------------------------------------------
# Absolute path to the vendor PKCS#11 module shared library.
#   SoftHSM2 (local): /usr/lib/softhsm/libsofthsm2.so
#   YubiHSM2:         /usr/lib/x86_64-linux-gnu/pkcs11/yubihsm_pkcs11.so
# PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# PKCS#11 slot ID containing the co-signer key (numeric).
# PKCS11_SLOT_ID=0
# User PIN used to log in to the token.  Prefer a secret manager over a
# plaintext .env in production.
# PKCS11_PIN=1234
# CKA_LABEL of the private key object used for signing.
# PKCS11_KEY_LABEL=lumen-cosigner

# -----------------------------------------------------------------------------
# Anchor (Phase 1)
# -----------------------------------------------------------------------------
ANCHOR_URL=https://testanchor.stellar.org
ANCHOR_AUTH_SECRET=S...

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
# Optional API key for protecting server endpoints (Authorization: Bearer <api-key>)
API_KEY=
# Rate limiting for /cosign and /fee-bump
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Pino log level for the server logger.
# Valid values: trace, debug, info, warn, error, fatal
# Defaults to "info" when unset or invalid.
LUMEN_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OpenTelemetry distributed tracing
# -----------------------------------------------------------------------------
# Traces HTTP requests, Redis policy checks, and Stellar RPC / Horizon calls,
# and exports them to an OTLP collector (Jaeger, Tempo, etc.).
# Tracing is disabled when OTEL_EXPORTER_OTLP_ENDPOINT is unset.
# -----------------------------------------------------------------------------
# OTLP/HTTP collector endpoint (e.g. http://localhost:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name reported in traces.  Defaults to "lumen-server".
# OTEL_SERVICE_NAME=lumen-server
# Trace sampler.  Valid values: always_on, always_off, traceidratio,
# parentbased_always_on, parentbased_always_off, parentbased_traceidratio.
# Defaults to "parentbased_always_on".
# OTEL_TRACES_SAMPLER=parentbased_always_on
# Ratio used by the *traceidratio samplers (0.0 – 1.0).
# OTEL_TRACES_SAMPLER_ARG=1.0
# Optional headers sent to the collector, e.g. for auth:
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
