{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "contracts:build": {
      "dependsOn": ["^build"],
      "outputs": ["target/**"]
    },
    "contracts:test": {
      "dependsOn": ["contracts:build"]
    },
    "contracts:lint": {
      "dependsOn": ["contracts:build"]
    }
  }
}