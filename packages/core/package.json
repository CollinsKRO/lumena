{
  "name": "@lumen/core",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run __tests__/fuzz",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lumen/types": "workspace:*",
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}