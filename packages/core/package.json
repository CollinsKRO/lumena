{
  "name": "@lumen/core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stellar": {
      "types": "./dist/stellar/index.d.ts",
      "import": "./dist/stellar/index.js",
      "default": "./dist/stellar/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js",
      "default": "./dist/telemetry/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/zk.d.ts",
      "import": "./dist/crypto/zk.js",
      "default": "./dist/crypto/zk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run __tests__/fuzz",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lumen/types": "workspace:*"
  },
  "peerDependencies": {
    "@noble/curves": "^1.8.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "snarkjs": "^0.7.5"
  },
  "peerDependenciesMeta": {
    "@noble/curves": {
      "optional": true
    },
    "@stellar/stellar-sdk": {
      "optional": true
    },
    "snarkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noble/curves": "^1.8.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^3.23.0",
    "snarkjs": "^0.7.5",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}