{
  "name": "@lumen/react-native",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumen/core": "workspace:*",
    "@lumen/web-sdk": "workspace:*",
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "expo-secure-store": ">=13",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-quick-crypto": ">=1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "expo-secure-store": "^14.0.0",
    "react-native-quick-crypto": "^1.0.7",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
